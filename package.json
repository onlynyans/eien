{
  "name": "eien",
  "productName": "Eien",
  "version": "0.1.0",
  "description": "A local Markdown notes app for writers.",
  "private": true,
  "type": "module",
  "main": "out/main/main.js",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:e2e": "install-electron && npm run build && playwright test --grep-invert @alone && playwright test --grep @alone --workers=1",
    "check": "npm run lint && npm run typecheck && npm test && npm run test:e2e",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run"
  },
  "engines": {
    "node": "^24.12.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@capacitor/cli": "8.5.3",
    "@playwright/test": "1.64.1",
    "@stryker-mutator/core": "10.0.0",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.0.5",
    "electron": "44.9.1",
    "electron-vite": "6.0.0",
    "fast-check": "4.10.2",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/clipboard": "8.0.1",
    "@capacitor/core": "8.5.3",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/preferences": "8.0.1",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@fontsource-variable/atkinson-hyperlegible-next": "5.3.0",
    "@fontsource-variable/hanken-grotesk": "5.3.0",
    "@fontsource-variable/ibm-plex-sans": "5.3.0",
    "@fontsource-variable/instrument-sans": "5.3.0",
    "@fontsource-variable/literata": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "@fontsource-variable/schibsted-grotesk": "5.3.0",
    "@fontsource-variable/source-sans-3": "5.3.1",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@lezer/common": "1.5.3",
    "@lezer/highlight": "1.2.5",
    "@lezer/markdown": "1.8.1",
    "yaml": "2.9.1"
  }
}
